rule taint_sqli
  language  java
  category  security
  severity  HIGH
  confidence 85
  source  request\.getParameter\s*\(  kind=http
  source  \.getTheParameter\s*\(  kind=http
  source  request\.getHeader\s*\(  kind=http
  source  request\.getHeaders\s*\(  kind=http
  source  request\.getParameterValues\s*\(  kind=http
  source  request\.getCookies\s*\(  kind=http
  source  request\.getRequestURL\s*\(  kind=http
  source  request\.getQueryString\s*\(  kind=http
  source  request\.getPathInfo\s*\(  kind=http
  source  request\.getReader\s*\(  kind=http
  source  request\.getInputStream\s*\(  kind=http
  source  headers\.nextElement\s*\(  kind=http
  source  theCookie\.getValue\s*\(  kind=http
  source  \.getValue\s*\(  kind=http
  source  request\.getRequestURI\s*\(  kind=http
  source  request\.getServletPath\s*\(  kind=http
  source  request\.getParameterMap\s*\(  kind=http
  source  request\.getParameterNames\s*\(  kind=http
  source  request\.getHeaderNames\s*\(  kind=http
  source  @QueryParam\s*\(  kind=http
  source  @PathParam\s*\(  kind=http
  source  @FormParam\s*\(  kind=http
  source  @HeaderParam\s*\(  kind=http
  source  @CookieParam\s*\(  kind=http
  source  @BeanParam\s*\(  kind=http
  source  System\.getenv\s*\(  kind=env
  source  \.getProperty\s*\(\s*"(?!os\.name|os\.version|line\.separator|file\.separator|path\.separator)  kind=env
  source  \.getInputStream\s*\(  kind=network
  source  InputStreamReader\s*\(\s*System\.in  kind=stdin
  sink    \.executeQuery\s*\(
  sink    \.executeUpdate\s*\(
  sink    \.execute\s*\(
  sink    createQuery\s*\(
  sink    \.queryForRowSet\s*\(
  sink    \.queryForObject\s*\(
  sink    \.queryForList\s*\(
  sink    \.queryForMap\s*\(
  sink    \.queryForInt\s*\(
  sink    \.queryForLong\s*\(
  sink    \.query\s*\(
  sink    \.update\s*\(
  sink    \.batchUpdate\s*\(
  sink    \.addBatch\s*\(
  sink    \.executeBatch\s*\(
  # Le texte SQL est déjà attaquable au moment du prepareStatement lui-même
  # (ex. un identifiant/nom de colonne concaténé dans la requête AVANT
  # préparation — PreparedStatement ne paramètre que les valeurs, pas les
  # identifiants). Reste aussi en passthrough ci-dessous pour propager le
  # taint vers l'objet Statement quand ce n'est pas le texte lui-même qui
  # est tainted (cf. docs/PLAN-JAVA-SPRING-DETECTION.md §3.3).
  sink    prepareStatement\s*\(
  sanitizer  setString\s*\(
  sanitizer  Integer\.parseInt\s*\(
  passthrough  prepareStatement\s*\(
  passthrough  createStatement\s*\(
  passthrough  URLDecoder\.decode
  passthrough  URLEncoder\.encode
  passthrough  String\.valueOf
  passthrough  \.trim\s*\(
  passthrough  \.toLowerCase\s*\(
  passthrough  \.toUpperCase\s*\(
  passthrough  \.substring\s*\(
  passthrough  \.replace\s*\(
  passthrough  \.replaceAll\s*\(
  passthrough  new\s+String\s*\(
  passthrough  \.toString\s*\(
  passthrough  Base64\.decode
  passthrough  \.getBytes\s*\(
  passthrough  \.charAt\s*\(
  passthrough  \.add\s*\(
  passthrough  \.put\s*\(
  passthrough  \.set\s*\(
  message
    en: SQL Injection — tainted data flows into a JDBC query
    fr: Injection SQL — données non fiables atteignent une requête JDBC
  end
  risk
    en: An attacker can read, modify, or delete database records.
    fr: Un attaquant peut lire, modifier ou supprimer des enregistrements de la base de données.
    es: Un atacante puede leer, modificar o eliminar registros de la base de datos.
    de: Ein Angreifer kann Datenbankeintraege lesen, aendern oder loeschen.
  end
  solution
    en: Use parameterized queries with placeholders (%s, ?).
    fr: Utilisez des requêtes paramétrées avec des placeholders (%s, ?).
    es: Usar consultas parametrizadas con placeholders (%s, ?).
    de: Verwenden Sie parametrisierte Abfragen mit Platzhaltern (%s, ?).
  end
  metadata
    cwe    CWE-89
    owasp  A03:2021
  end
  benefit
    en: Reduces attack surface and strengthens application security.
    fr: Reduit la surface d'attaque et renforce la securite de l'application.
    es: Reduce la superficie de ataque y refuerza la seguridad de la aplicacion.
    de: Reduziert die Angriffsflaeche und staerkt die Anwendungssicherheit.
  end
  fix_before
    stmt.executeQuery(query);
  end
  fix_after
    PreparedStatement ps = conn.prepareStatement("SELECT * FROM t WHERE id=?");
    ps.setString(1, param);
  end
  requires
    demo_fallback  true
  end
end
