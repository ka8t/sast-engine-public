rule taint_sqli
  language  csharp
  category  security
  severity  HIGH
  confidence 85
  source  Request\.Query\[  kind=http
  source  Request\.QueryString\[  kind=http
  source  Request\[  kind=http
  source  Request\.Form\[  kind=http
  source  Request\.Headers\[  kind=http
  source  args\[  kind=cli
  source  Request\.Cookies  kind=http
  source  Request\.Body  kind=http
  source  Request\.Path  kind=http
  source  HttpContext\.Request  kind=http
  source  \.QueryString\[  kind=http
  source  \.Params\[  kind=http
  source  \.Params\.Get\s*\(  kind=http
  source  \.Form\[  kind=http
  source  \.Headers\[  kind=http
  source  \.Cookies\[  kind=http
  source  \.Cookies\.Get\s*\(  kind=http
  source  Environment\.GetEnvironmentVariable\s*\(  kind=env
  source  \.ReadLine\s*\(  kind=network
  sink    SqlCommand\s*\(
  sink    \.CommandText\s*\+?=
  sink    \.ExecuteReader\s*\(
  sink    \.ExecuteNonQuery\s*\(
  sink    FromSqlRaw\s*\(
  sanitizer  Parameters\.Add
  sanitizer  SqlParameter\s*\(
  sanitizer  int\.Parse\s*\(
  passthrough  WebUtility\.UrlDecode
  passthrough  WebUtility\.HtmlDecode
  passthrough  Convert\.ToString
  passthrough  \.Trim\s*\(
  passthrough  \.ToLower\s*\(
  passthrough  \.ToUpper\s*\(
  passthrough  \.Substring\s*\(
  passthrough  \.Replace\s*\(
  message
    en: SQL Injection — tainted data flows into a SqlCommand
    fr: Injection SQL — données non fiables atteignent un SqlCommand
  end
  risk
    en: An attacker can read, modify, or delete database records.
    fr: Un attaquant peut lire, modifier ou supprimer des enregistrements de la base de données.
    es: Un atacante puede leer, modificar o eliminar registros de la base de datos.
    de: Ein Angreifer kann Datenbankeintraege lesen, aendern oder loeschen.
  end
  solution
    en: Use parameterized queries with placeholders (%s, ?).
    fr: Utilisez des requêtes paramétrées avec des placeholders (%s, ?).
    es: Usar consultas parametrizadas con placeholders (%s, ?).
    de: Verwenden Sie parametrisierte Abfragen mit Platzhaltern (%s, ?).
  end
  metadata
    cwe    CWE-89
    owasp  A03:2021
  end
  benefit
    en: Reduces attack surface and strengthens application security.
    fr: Reduit la surface d'attaque et renforce la securite de l'application.
    es: Reduce la superficie de ataque y refuerza la seguridad de la aplicacion.
    de: Reduziert die Angriffsflaeche und staerkt die Anwendungssicherheit.
  end
  fix_before
    cmd.CommandText = query;
  end
  fix_after
    cmd.CommandText = "SELECT * FROM t WHERE id=@p";
    cmd.Parameters.AddWithValue("@p", value);
  end
  requires
    demo_fallback  true
  end
end
