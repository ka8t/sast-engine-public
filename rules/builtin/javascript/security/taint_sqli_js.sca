rule taint_sqli_js
  language  javascript
  category  security
  severity  HIGH
  confidence 85
  source  req\.(params|query|body)\.  kind=http
  source  req\.params\[  kind=http
  source  req\.body\[  kind=http
  source  req\.body  kind=http
  source  process\.argv\[  kind=cli
  source  process\.env\.  kind=env
  source  req\.cookies  kind=http
  source  req\.headers  kind=http
  source  req\.ip  kind=http
  source  req\.hostname  kind=http
  source  req\.url  kind=http
  source  req\.path  kind=http
  source  req\.get\s*\(  kind=http
  sink    \.query\s*\(
  sink    \.execute\s*\(
  sink    \.raw\s*\(
  sink    \$queryRaw\s*\(
  sanitizer  \.escape\s*\(
  sanitizer  parameterized
  sanitizer  parseInt\s*\(
  sanitizer  Number\s*\(
  sanitizer  \.query\s*\(\s*["'][^"']*\?[^"']*["']\s*,
  sanitizer  \.execute\s*\(\s*["'][^"']*\?[^"']*["']\s*,
  passthrough  decodeURIComponent
  passthrough  encodeURIComponent
  passthrough  JSON\.parse
  passthrough  JSON\.stringify
  passthrough  \.trim\s*\(
  passthrough  \.toLowerCase\s*\(
  passthrough  \.toUpperCase\s*\(
  passthrough  \.slice\s*\(
  passthrough  \.substring\s*\(
  passthrough  \.replace\s*\(
  passthrough  \.split\s*\(
  passthrough  \.join\s*\(
  passthrough  String\s*\(
  passthrough  \.toString\s*\(
  message
    en: SQL Injection — tainted data flows into a database query
    fr: Injection SQL — données non fiables atteignent une requête de base de données
  end
  risk
    en: An attacker can read, modify, or delete database records.
    fr: Un attaquant peut lire, modifier ou supprimer des enregistrements de la base de données.
    es: Un atacante puede leer, modificar o eliminar registros de la base de datos.
    de: Ein Angreifer kann Datenbankeintraege lesen, aendern oder loeschen.
  end
  solution
    en: Use parameterized queries with placeholders (%s, ?).
    fr: Utilisez des requêtes paramétrées avec des placeholders (%s, ?).
    es: Usar consultas parametrizadas con placeholders (%s, ?).
    de: Verwenden Sie parametrisierte Abfragen mit Platzhaltern (%s, ?).
  end
  metadata
    cwe    CWE-89
    owasp  A03:2021
  end
  benefit
    en: Reduces attack surface and strengthens application security.
    fr: Reduit la surface d'attaque et renforce la securite de l'application.
    es: Reduce la superficie de ataque y refuerza la seguridad de la aplicacion.
    de: Reduziert die Angriffsflaeche und staerkt die Anwendungssicherheit.
  end
  fix_before
    db.query("SELECT * FROM t WHERE id=" + val);
  end
  fix_after
    db.query("SELECT * FROM t WHERE id=$1", [val]);
  end
  requires
    demo_fallback  true
  end
end
