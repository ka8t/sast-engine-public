rule data_uri_html_tag
  language  html
  category  security
  severity  HIGH
  confidence 90
  match
    pattern  (src|href)\s*=\s*['"]data\s*:\s*text/html
    scope    line
  end
  metadata
    cwe    CWE-79
  end
  risk
    en: src/href with data:text/html loads executable HTML content directly in the browser (CWE-79).
    fr: src/href avec data:text/html charge du contenu HTML exécutable directement dans le navigateur (CWE-79).
    es: src/href with data:text/html loads executable HTML content directly in the browser (CWE-79).
    de: src/href with data:text/html loads executable HTML content directly in the browser (CWE-79).
  end
  solution
    en: Forbid data:text/html in src and href attributes.
    fr: Interdire les data:text/html dans les attributs src et href.
    es: Forbid data:text/html in src and href attributes.
    de: Forbid data:text/html in src and href attributes.
  end
  benefit
    en: Reduces attack surface and strengthens application security.
    fr: Reduit la surface d'attaque et renforce la securite de l'application.
    es: Reduce la superficie de ataque y refuerza la seguridad de la aplicacion.
    de: Reduziert die Angriffsflaeche und staerkt die Anwendungssicherheit.
  end
  fix_before
    <a href="data:text/html,<script>alert(1)</script>">
  end
  fix_after
    <a href="/page">Safe link</a>
  end
  requires
    demo_fallback  true
  end
end
